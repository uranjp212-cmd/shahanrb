<div class="order-container">
  <h2>社販受注 <%= @is_edit ? "修正画面" : "登録画面" %></h2>
  <p class="user-info">ログイン社員: <%= current_shain.shaincd %> <%= current_shain.try(:SHAINNAME) %></p>

  <% if @is_edit %>
    <div class="alert alert-info" style="background-color: #e8f4f8; color: #1d6f8a; border-color: #bce8f1; padding: 10px; margin-bottom: 15px;">
      ※ 本日の受注データが既に存在します。内容を変更して「更新する」を押すと上書き保存されます。
    </div>
  <% end %>
  <%= form_with(url: orders_path, local: true, data: { turbo: false }, id: "order-form") do |f| %>
    <input type="hidden" name="is_edit" value="<%= @is_edit %>">
    <table class="order-table" id="order-table">
      <thead>
        <tr>
          <th style="width: 50px;">NoNo</th>
          <th style="width: 140px;">商品コード</th>
          <th style="width: 300px;">商品名</th>
          <th style="width: 100px;">単価</th>
          <th>数量</th>
          <th>金額</th>
          <th style="width: 70px;">操作</th>
        </tr>
      </thead>
      <tbody id="order-items-tbody">
        <% @inputdtls.each_with_index do |item, index| %>
          <tr class="item-row">
            <td class="row-number"><%= index + 1 %></td>
            <td>
              <input type="text" 
                     name="items[][item_cd]" 
                     value="<%= item[:item_cd] %>" 
                     maxlength="6" 
                     placeholder="123456" 
                     class="input-item-cd" 
                     oninput="handleCodeInput(this)"
                     onblur="fetchProductInfo(this)">
            </td>
            <!-- 商品名・単価の表示セル -->
            <td class="product-name"><%= item[:item_name] %></td>
            <td class="product-price" data-price="<%= item[:price] || 0 %>">
              <%= (item[:price] || 0) %>
            </td>
            <td>
              <input type="number" 
                      name="items[][quantity]" 
                      value="<%= item[:quantity] || 1 %>" 
                      min="1" 
                      class="item-quantity-input"
                      oninput="calculateRowAndTotal()">
            </td>
            <td class="item-subtotal">
              <%= (item[:subtotal] || 0) %>
            </td>
            <td>
              <button type="button" class="btn-remove" onclick="removeRow(this)">削除</button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="total-container" style="text-align: right; margin: 15px 0; font-size: 1.2em; font-weight: bold;">
      合計金額: <span id="total-amount">0</span> 円
    </div>

    <div class="table-actions">
      <button type="button" id="btn-add-row" class="btn-secondary" onclick="addRow()">+ 行を追加する</button>
    </div>

    <div class="form-actions">
      <%= f.submit (@is_edit ? "受注内容を更新する" : "受注を確定する"), class: "btn-primary" %>
    </div>
  <% end %>
  <!-- ★ 登録完了時に表示されるログアウトボタン -->
  <% if flash[:notice].present? %>
    <%= link_to "ログアウトする", logout_path, data: { turbo_method: :delete }, class: "btn-logout", style: "background-color: #dc3545; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px;" %>
  <% end %>
</div>

<script>
  // 画面読み込み完了時に自動計算を実行
  document.addEventListener('turbo:load', function() {
    calculateRowAndTotal();
  });

  // 入力中に5,6桁に達した時点で自動取得
  function handleCodeInput(input) {
    const code = input.value.trim();

    if (code.length === 5 || code.length === 6) {
      fetchProductInfo(input);
    }
  }

  // Ajax (Fetch API) による商品情報の取得と描画
  async function fetchProductInfo(input) {
    const code = input.value.trim();
    const row = input.closest('tr');
    const nameEl = row.querySelector('.product-name');
    const priceEl = row.querySelector('.product-price');

    // 6桁未満の場合はクリアして終了
    if (code.length < 5  || code.length > 6) {
      nameEl.textContent = '-';
      nameEl.style.color = '#666';
      priceEl.textContent = '-';
      return;
    }

    // 読み込み中表示
    nameEl.textContent = '取得中...';
    nameEl.style.color = '#999';

    try {
      const response = await fetch(`/products/search?code=${encodeURIComponent(code)}`);
      const data = await response.json();

      if (data.found) {
        nameEl.textContent = data.name;
        nameEl.style.color = '#333';
        // priceEl.textContent = `\${data.price.toLocaleString()}`;
        priceEl.textContent = data.price;
      } else {
        nameEl.textContent = data.message; // 「該当する商品がありません」
        nameEl.style.color = '#d9534f';    // 赤字警告
        priceEl.textContent = '-';
      }
    } catch (error) {
      console.error('商品情報の取得エラー:', error);
      nameEl.textContent = '通信エラー';
      nameEl.style.color = '#d9534f';
      priceEl.textContent = '-';
    }
  }

  // 行追加
  function addRow() {
    const tbody = document.getElementById('order-items-tbody');
    const rowCount = tbody.getElementsByClassName('item-row').length;
    const newRow = document.createElement('tr');
    newRow.className = 'item-row';
    newRow.innerHTML = `
      <td class="row-number">${rowCount + 1}</td>
      <td>
        <input type="text" 
               name="items[][item_cd]" 
               maxlength="6" 
               placeholder="123456" 
               class="input-item-cd" 
               oninput="handleCodeInput(this)"
               onblur="fetchProductInfo(this)">
      </td>
      <td class="product-name-cell"><span class="product-name" style="color: #666;">-</span></td>
      <td class="product-price-cell"><span class="product-price">-</span></td>
      <td>
        <input type="number" name="items[][quantity]" value="1" min="1" max="99" class="input-quantity"
        oninput="calculateRowAndTotal()" required>
      </td>
      <td class="product-subtotal-cell"><span class="product-subtotal">-</span></td>
      <td>
        <button type="button" class="btn-remove" onclick="removeRow(this)">削除</button>
      </td>
    `;
    tbody.appendChild(newRow);
    renumberRows();
  }

  // 行削除
  function removeRow(button) {
    const tbody = document.getElementById('order-items-tbody');
    if (tbody.getElementsByClassName('item-row').length > 1) {
      button.closest('tr').remove();
      renumberRows();
    } else {
      alert('明細は1行以上必要です。');
    }
  }

  // 行番号再振り直し
  function renumberRows() {
    const rows = document.querySelectorAll('#order-items-tbody .item-row');
    rows.forEach((row, index) => {
      row.querySelector('.row-number').textContent = index + 1;
    });
  }

document.getElementById('order-form').addEventListener('submit', function(e) {
  const codeInputs = document.querySelectorAll('.input-item-cd');
  let hasValidInput = false;

  codeInputs.forEach(input => {
    if (input.value.trim() !== '') {
      hasValidInput = true;
    }
  });

  // 1件も商品コードが入力されていない場合は送信をストップ
  if (!hasValidInput) {
    e.preventDefault();
    alert('明細を1件以上入力してください。');
  }
});

// 明細金額および合計金額を計算する関数
function calculateRowAndTotal() {
  let totalSum = 0;
  const rows = document.querySelectorAll('#order-table tbody tr');

  rows.forEach(row => {
    const price = parseFloat(row.querySelector('.product-price').dataset.price) || 0;
    const quantityInput = row.querySelector('.item-quantity-input');
    const quantity = parseInt(quantityInput ? quantityInput.value : 0, 10) || 0;

    // 明細金額の計算
    const subtotal = price * quantity;
    const subtotalElement = row.querySelector('.item-subtotal');
    if (subtotalElement) {
      subtotalElement.textContent = subtotal.toLocaleString();
    }

    // 総合計の加算
    totalSum += subtotal;
  });

  // 総合計金額の表示更新
  const totalAmountElement = document.getElementById('total-amount');
  if (totalAmountElement) {
    totalAmountElement.textContent = totalSum.toLocaleString();
  }
}

// 数量入力時に計算を実行
document.addEventListener('input', function(e) {
  if (e.target.classList.contains('item-quantity-input')) {
    calculateRowAndTotal();
  }
});

</script>
