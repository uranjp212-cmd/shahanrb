                                  selection_type: 'existing',
                                  delivno: d[:delivno], 
                                  delivmei: d[:delivmei], 
                                  delivery_tel: d[:tel], 
                                  address_cd: d[:adrcd], 
                                  address_after: d[:adr23], 
                                  zipno: nil 
                                }, 
