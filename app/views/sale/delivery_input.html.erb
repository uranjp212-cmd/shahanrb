          <input type="hidden" id="new_address_base">
        </div>
        <div>adrcd=<%= @current_delivery.present? ? @current_delivery[:address_cd] : '' %></div>
        <div class="mb-3">
          <%= f.label :address_after, "住所番地以降", class: "form-label fw-bold" %>
