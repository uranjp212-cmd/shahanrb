// B. 新規配送先を入力・適用した場合
function selectNewAddress(event) {
  const delivmei = document.getElementById('delivmei').value.trim();
  const tel = document.getElementById('delivery_tel').value.trim();
  const addressCd = document.getElementById('new_address_cd').value.trim();
  const addressBase = document.getElementById('new_address_base').value.trim();
  const addressAfter = document.getElementById('new_address_after').value.trim();

  debugger;
  errflg = false;
  if (!delivmei) {
    alert('お届先を入力してください。');
    errflg = true;
  } else if (!tel ) {
    alert('電話番号を入力してください。');
    errflg = true;
  } else if (!addressCd ) {
    alert('住所を選択してください。');
    errflg = true;
  } else if (!addressAfter ) {
    alert('番地以降を入力してください。');
    errflg = true;
  } else {
      // それ以外
  }
  // if (!tel.matches("^[0-9]{7,}$")) {
  //   alert('電話番号は１０桁以上の数字で入力してください。');
  //   errflg = true;
  // }

  if (errflg) {
    // ★ここでフォームの送信（POST）をガッチリとストップする！
    if (event) {
      event.preventDefault();
    }
    return false;
  }

  // 既存 delivno は空にし、新規項目をセット
  document.getElementById('hid_delivno').value = '0';
  document.getElementById('hid_delivmei').value = delivmei;
  document.getElementById('hid_delivery_tel').value = tel;
  document.getElementById('hid_address_cd').value = addressCd;
  document.getElementById('hid_address_after').value = addressAfter;

  // 画面表示の更新
  document.getElementById('selected-delivery-info').innerHTML = 
    `<strong>[新規]</strong> ${delivmei} 様 (${tel}) <br> ${addressBase} ${addressAfter}`;

  closeDeliveryModal();
}

// エスケープ用ユーティリティ
function escapeHtml(str) {
  return (str || '').replace(/[&<>"']/g, match => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  }[match]));
}
function escapeJs(str) {
  return (str || '').replace(/'/g, "\\'");
}

// 郵便番号入力時の検索関数
async function searchAddressByZip(zipValue, targetCd = savedAddressCd) {
  const selectEl = document.getElementById('select_address_cd');
  const hidAddressCd = document.getElementById('new_address_cd');
  const hidAddressBase = document.getElementById('new_address_base');

  const cleanZip = zipValue.replace(/[^0-9]/g, '');
  // debugger;
  if (cleanZip.length < 7) {
    if (cleanZip.length > 0) {
      // 途中で入力が止まっている場合などにアラートを出す
      alert('7桁の郵便番号を入力してください。');
    }
    resetAddressSelect('7桁の郵便番号を入力してください');
    return;
  }

  try {
    const response = await fetch(`/delivery_addresses/search_address?zip=${cleanZip}`);
    const data = await response.json();

    if (!data.found || !data.candidates || data.candidates.length === 0) {
      alert(data.message || '該当する住所が見つかりませんでした。');
      resetAddressSelect('住所が見つかりません');
      return;
    }

    // ドロップダウンを初期化して有効化
    selectEl.innerHTML = '';
    selectEl.disabled = false;

    // 候補が複数ある場合の初期未選択肢
    if (data.candidates.length > 1) {
      const defaultOpt = document.createElement('option');
      defaultOpt.value = '';
      defaultOpt.textContent = '-- 選択してください --';
      selectEl.appendChild(defaultOpt);
    }

    // 取得した候補を option に追加
    data.candidates.forEach(item => {
      const opt = document.createElement('option');
      const itemVal = item.adrcd1 + "-" + item.adrcd2 + "-" + item.adrcd3 + "-" + item.adrcd4;
      opt.value = itemVal
      opt.textContent = item.full_address_text;
      // ★ targetCd（前回の選択値）と一致する場合は選択状態にする
      if (targetCd && itemVal === targetCd) {
        opt.selected = true;
      }
      selectEl.appendChild(opt);
    });

    // 候補が1件だけの場合は自動選択
    if (data.candidates.length === 1) {
      selectEl.selectedIndex = 0;
      hidAddressCd.value = data.candidates[0].adrcd1
                    + "-" + data.candidates[0].adrcd2
                    + "-" + data.candidates[0].adrcd3
                    + "-" + data.candidates[0].adrcd4;
      hidAddressBase.value = data.candidates[0].full_address_text;
    } else {
      // 初期ロード中であれば、クリアしない
      if (!isInitialLoading) {
        hidAddressCd.value = '';
        hidAddressBase.value = '';
      }
    }

  } catch (error) {
    console.error('住所検索エラー:', error);
    resetAddressSelect('検索エラーが発生しました');
  }
}

// ドロップダウンの選択が変わった時
function onAddressSelectChange(selectEl) {
  const selectedOption = selectEl.options[selectEl.selectedIndex];
  // debugger;
  if (selectedOption && selectedOption.value !== '') {
    document.getElementById('new_address_cd').value = selectedOption.value;
    document.getElementById('new_address_base').value = selectedOption.textContent;
  } else {
    document.getElementById('new_address_cd').value = '';
    document.getElementById('new_address_base').value = '';
  }
}

// 選択ボックスのリセット補助関数
function resetAddressSelect(message) {
  const selectEl = document.getElementById('select_address_cd');
  // debugger;
  selectEl.innerHTML = `<option value="">${message}</option>`;
  selectEl.disabled = true;
  document.getElementById('new_address_cd').value = '';
  document.getElementById('new_address_base').value = '';
}

