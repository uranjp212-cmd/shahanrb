  </div>

  <%# --- 1. 既存配送先の一覧（データがある場合のみ見出しとリストを表示） --- %>
  <% if @deliveries.present? && @deliveries.any? %>
    <%# --- 1. 既存の配送先が選ばれていた場合の表示枠 --- %>
    <% if @current_delivery.present? && @current_delivery[:selection_type] = "existing" %>
      <div class="alert alert-info mb-4">
        <%# <h5 class="alert-heading fw-bold">現在選択されている配送先</h5> %>
        <p class="mb-1"><strong>選択中の配送先番号:</strong> <span class="badge bg-primary fs-5"><%= @current_delivery[:delivno] %></span></p>
      </div>
      <% @current_delivery[:delivmei] = "" %> <%# 新規入力欄に表示しない %>
    <% end %>
    <div class="card-body">
      <!-- 1. 既存配送先一覧 -->
      <h6 style="font-size: 16px;">登録済み配送先一覧</h6>
      <!-- 
      <link href="delivery.css" rel="stylesheet" type="text/css">
      -->
      <div class="table-responsive style-max-height" style="max-height: 220px; overflow-y: auto;">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light sticky-top">
            <tr>
              <th>№</th>
              <th>お届け先氏名</th>
              <th>電話番号</th>
              <th>住所</th>
              <th>操作</th>
