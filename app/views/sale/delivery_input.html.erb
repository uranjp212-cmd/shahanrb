// 郵便番号をハイフン付き（〒xxx-xxxx）に整形する補助関数
function formatZipCode(zip) {
  if (!zip) return '';
  const cleanZip = zip.toString().replace(/-/g, '');
  if (cleanZip.length === 7) {
    return `〒${cleanZip.slice(0, 3)}-${cleanZip.slice(3)}`;
  }
  return `〒${cleanZip}`;
}

// XSS対策用のエスケープ関数
function escapeHtml(str) {
  if (!str) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

// ★ ページ読み込み時に、前回の郵便番号がすでにセットされている場合は自動で検索関数を実行する
document.addEventListener('DOMContentLoaded', () => {
  const postalInput = document.getElementById('new_zip');
  if (postalInput && postalInput.value.trim() !== "") {
    searchAddressByZip(postalInput.value.trim(), savedAddressCd);
