              <% is_selected = (@current_delivery.present? && @current_delivery[:delivno].to_s == d[:delivno].to_s) %>
              <tr class="<%= is_selected ? 'table-primary' : '' %>">
                <td>
                  <span class="fw-bold"><%= d[:delivno] %></span>
                  <% if is_selected %>
