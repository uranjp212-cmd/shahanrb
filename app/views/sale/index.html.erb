<div class="container mt-4">
  <h2 class="mb-4">既存受注一覧</h2>

  <%# 新規受注登録ボタン %>
  <div class="mb-3 text-end">
    <%= link_to "新規受注登録", new_sale_path(from: 'index'), class: "btn btn-success px-4" %>
  </div>

  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th>受注番号</th>
          <th>金額</th>
          <th>1行目の商品名</th>
          <th>明細行数</th>
          <th>お届け先名</th>
          <th class="text-center" colspan="2">操作</th>
        </tr>
      </thead>
      <tbody>
        <% if @existing_orders %>
        <% @existing_orders .each do |order| %>
          <tr>
            <td><%= order[:juchuno] %></td>
            <td class="text-end"><%= number_to_currency(order[:total_amount], unit: "¥", precision: 0) %></td>
            <td><%= order[:first_item_name] %></td>
            <td class="text-center"><%= order[:item_count] %>行</td>
            <td><%= order[:delivmei] %></td>
<!-- これはHTMLコメントです。二重化すると両方コメントとなる
<%# これはERBコメントです。ブラウザのHTMLソースには表示されません
            <div class="d-flex justify-content-center align-items-center gap-2">
                <%# 修正ボタン %>
              <td class="text-center align-middle">
                  <%= link_to "修正", edit_sale_path(juchuno: order[:juchuno], is_edit: "true"), class: "btn btn-outline-primary btn-sm px-3" %>
              </td>
                <%# 削除ボタン（link_to の turbo_method を使うことで、余計なフォームを生成せず完全に横並びになります） %>
              <td class="text-center align-middle">
                  <%= link_to "削除", destroy_sale_path(juchuno: order[:juchuno]), 
                                data: { turbo_method: :delete, turbo_confirm: "受注番号 #{order[:juchuno]} を本当に削除しますか？" }, 
                                style: "color: red;",
                                class: "btn btn-outline-danger btn-sm px-3" %>
              </td>
            </div>
%>
-->
            <td class="text-center">
              <%# 該当の受注番号を渡して修正画面へ遷移 %>
              <%= link_to "修正", edit_sale_path(juchuno: order[:juchuno],is_edit: "true"), class: "btn btn-outline-primary btn-sm px-3" %>
            </td>
            <%# 削除ボタン（button_to と method: :delete を使用） %>
            <td><%= button_to "削除", destroy_sale_path(juchuno: order[:juchuno]), 
                            method: :delete, 
                            data: { turbo_confirm: "受注番号 #{order[:juchuno]} を本当に削除しますか？" }, 
                            style: "color: red;",
                            class: "btn btn-outline-danger btn-sm px-3" %></td>
            </td>
          </tr>
        <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
  <p ></p>
  <%= link_to ("戻る"), logout_path, data: { turbo_method: :delete }, class: "btn-logout", style: "background-color: #dc3545; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px;" %>
</div>