<div class="order-container">
  <h2>社販受注 <%= @is_edit ? "修正画面" : "登録画面" %></h2>
  <!-- ★ 更新・登録成功メッセージ表示エリア -->
  <% if flash[:order_success] %>
    <div class="alert alert-success" style="background-color: #d4edda; color: #155724; padding: 12px 16px; margin-bottom: 20px; border: 1px solid #c3e6cb; border-radius: 4px; font-weight: bold;">
      <%= flash[:order_success] %>
    </div>
  <% elsif flash[:alert] %>
    <div class="alert alert-danger" style="background-color: #f8d7da; color: #721c24; padding: 12px 16px; margin-bottom: 20px; border: 1px solid #f5c6cb; border-radius: 4px; font-weight: bold;">
      <%= flash[:alert] %>
    </div>
  <% end %>
  <p class="user-info">ログイン社員: <%= current_shain.shaincd %> <%= current_shain.try(:SHAINNAME) %></p>

  <% if @is_edit and !@is_completed %>
    <div class="alert alert-info" style="background-color: #e8f4f8; color: #1d6f8a; border-color: #bce8f1; padding: 10px; margin-bottom: 15px;">
      ※ 本日の受注データが既に存在します。内容を変更して「更新する」を押すと上書き保存されます。
    </div>
  <% end %>
  <%= form_with(url: sale_path, local: true, data: { turbo: false }, id: "order-form") do |f| %>
    <input type="hidden" name="is_edit" value="<%= @is_edit %>">
    <table class="order-table" id="order-table">
      <thead>
        <tr>
          <th style="width: 50px;">行</th>
          <th style="width: 140px;">商品コード</th>
          <th style="width: 300px;">商品名</th>
          <th style="width: 100px;">単価</th>
          <th>数量</th>
          <th>金額</th>
          <th style="width: 70px;">操作</th>
        </tr>
      </thead>
      <tbody id="order-items-tbody">
        <% @inputdtls.each_with_index do |item, index| %>
          <tr class="item-row">
            <td class="row-number"><%= index + 1 %></td>
            <!-- 1. 品番・カラー・サイズエリア -->
            <td>
              <div style="display: flex; gap: 4px; align-items: center;">
                <!-- 品番（半角数字・英数等） -->
                <input type="text" 
                      name="items[][item_cd]" 
                      value="<%= item[:item_cd] %>" 
                      placeholder="品番" 
                      class="input-item_cd" 
                      style="width: 80px;"
                      oninput="handleCodeInput(this)"
                      onblur="onHinbanBlur(this)">
                <!-- カラー（初期は非活性、品番入力後に設定） -->
                <select name="items[][color]" 
                        class="select-color" 
                        onchange="onColorChange(this)" 
                        disabled>
                  <option value="">カラー</option>
                </select>

                <!-- サイズ（初期は非活性、カラー選択後に設定） -->
                <select name="items[][size]" 
                        class="select-size" 
                        onchange="onSizeChange(this)" 
                        disabled>
                  <option value="">サイズ</option>
                </select>
              </div>
            </td>
            <!-- 商品名・単価の表示セル -->
            <td class="product-name"><%= item[:item_name] %></td>
            <td class="product-price" data-price="<%= item[:price] || 0 %>">
              <%= (item[:price] || 0) %>
            </td>
            <td>
              <input type="number" 
                      name="items[][quantity]" 
                      value="<%= item[:quantity] || 1 %>" 
                      min="1" 
                      class="item-quantity-input"
                      oninput="calculateRowAndTotal()">
            </td>
            <td class="item-subtotal">
              <%= (item[:subtotal] || 0) %>
            </td>
            <td>
              <button type="button" class="btn-remove" onclick="removeRow(this)">削除</button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="total-container" style="text-align: right; margin: 15px 0; font-size: 1.2em; font-weight: bold;">
      合計金額: <span id="total-amount">0</span> 円
    </div>

    <div class="table-actions">
      <button type="button" id="btn-add-row" class="btn-secondary" onclick="addRow()">+ 行を追加する</button>
    </div>

    <div class="form-actions">
      <%= f.submit (@is_edit ? "受注内容を更新する" : "受注を確定する"), class: "btn-primary" %>
    </div>
  <% end %>
<!-- これはHTMLコメントです。二重化すると両方コメントとなる
<%# これはERBコメントです。ブラウザのHTMLソースには表示されません
  <p style="color: red; font-weight: bold;">
    デバッグ表示: <%= @is_completed.inspect %>
  </p>
%>
-->
  <!-- ★ 登録完了時に表示されるログアウトボタン -->
  <% if @is_completed %>
    <p ></p>
    <%= link_to "ログアウトする", logout_path, data: { turbo_method: :delete }, class: "btn-logout", style: "background-color: #dc3545; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px;" %>
  <% end %>
</div>

<script>
  // 全行のカラー・サイズマップデータを一時保持するオブジェクト
  const rowProductDataMap = new WeakMap();

  // 画面読み込み完了時に自動計算を実行
  document.addEventListener('turbo:load', function() {
    calculateRowAndTotal();
  });
  // ① 品番入力時（フォーカスが外れた時）
  async function onHinbanBlur(inputEl) {
    const row = inputEl.closest('tr');
    const hinban = inputEl.value.trim();

    const colorSelect = row.querySelector('.select-color');
    const sizeSelect = row.querySelector('.select-size');
    const nameEl = row.querySelector('.product-name');
    const priceEl = row.querySelector('.product-price');

    // 初期化ヘルパー
    resetRow(row);

    // console.log({ hinban });
    // debugger;
    if (!hinban) return;

    nameEl.textContent = '検索中...';

    try {
      const response = await fetch(`/products/search_by_hinban?hinban=${encodeURIComponent(hinban)}`);
      const data = await response.json();

      if (data.found) {
        // ★ パターン①：カラー・サイズ指定なし（1品番1商品）の場合
        if (data.is_single) {
          // 単価・金額を即座にセット
          priceEl.textContent = Number(data.price).toLocaleString();
          priceEl.dataset.price = data.price;

          // カラー・サイズ欄は「指定なし」で無効化
          colorSelect.innerHTML = '<option value=" ">-</option>';
          colorSelect.disabled = false;
          sizeSelect.innerHTML = '<option value=" ">-</option>';
          sizeSelect.disabled = false;

        // ★ パターン②：カラー・サイズの選択が必要な場合
        } else {
          rowProductDataMap.set(row, data.color_size_map);

          colorSelect.innerHTML = '<option value=" ">カラー</option>';
          data.colors.forEach(color => {
            const opt = document.createElement('option');
            opt.value = color;
            opt.textContent = color;
            colorSelect.appendChild(opt);
          });
          colorSelect.disabled = false;
        }

      } else {
        nameEl.textContent = data.message;
        nameEl.style.color = '#d9534f';
      }
    } catch (error) {
      console.error('品番検索エラー:', error);
      nameEl.textContent = '通信エラー';
    }
  }

  // ② カラー選択時
  function onColorChange(colorSelect) {
    const row = colorSelect.closest('tr');
    const selectedColor = colorSelect.value;
    const sizeSelect = row.querySelector('.select-size');
    const priceEl = row.querySelector('.product-price');

    // サイズ・単価を一旦リセット
    sizeSelect.innerHTML = '<option value="">サイズ</option>';
    sizeSelect.disabled = true;
    priceEl.textContent = '0';
    priceEl.dataset.price = '0';
    calculateRowAndTotal();

    if (!selectedColor) return;

    const colorSizeMap = rowProductDataMap.get(row);
    if (!colorSizeMap || !colorSizeMap[selectedColor]) return;

    // 選択されたカラーに対応するサイズ候補を設定
    const sizeList = colorSizeMap[selectedColor];
    sizeList.forEach(item => {
      const opt = document.createElement('option');
      opt.value = item.size;
      opt.textContent = item.size;
      opt.dataset.price = item.price; // 選択時に単価が取れるようデータ属性に忍ばせる
      sizeSelect.appendChild(opt);
    });

    sizeSelect.disabled = false;
  }

  // ③ サイズ決定時（ここで単価・金額確定）
  function onSizeChange(sizeSelect) {
    const row = sizeSelect.closest('tr');
    const selectedOption = sizeSelect.options[sizeSelect.selectedIndex];
    const priceEl = row.querySelector('.product-price');

    if (selectedOption && selectedOption.value !== "") {
      // 選択されたサイズの単価を取得
      const price = parseInt(selectedOption.dataset.price, 10) || 0;
      priceEl.textContent = price.toLocaleString();
      priceEl.dataset.price = price; // ★計算用に data-price を更新！
    } else {
      priceEl.textContent = '0';
      priceEl.dataset.price = '0';
    }

    // 行小計および総合計の自動再計算
    calculateRowAndTotal();
  }

    // 表示リセット用の関数
  function resetRow(row) {
    const colorSelect = row.querySelector('.select-color');
    const sizeSelect = row.querySelector('.select-size');
    const priceEl = row.querySelector('.product-price');
    
    colorSelect.innerHTML = '<option value="">カラー</option>';
    colorSelect.disabled = true;
    
    sizeSelect.innerHTML = '<option value="">サイズ</option>';
    sizeSelect.disabled = true;

    priceEl.textContent = '0';
    priceEl.dataset.price = '0';
    
    calculateRowAndTotal();
  }

  // 入力中に5,6桁に達した時点で自動取得
  function handleCodeInput(input) {
    const code = input.value.trim();

    if (code.length === 5 || code.length === 6) {
      // fetchProductInfo(input);
      onHinbanBlur(input);
    }
  }

  // 行追加
  function addRow() {
    const tbody = document.getElementById('order-items-tbody');
    const rowCount = tbody.getElementsByClassName('item-row').length;
    const newRow = document.createElement('tr');
    newRow.className = 'item-row';
    newRow.innerHTML = `
      <td class="row-number">${rowCount + 1}</td>
      <td>
        <div style="display: flex; gap: 4px; align-items: center;">
          <input type="text" 
                name="items[][item_cd]" 
                maxlength="6" 
                placeholder="123456" 
                class="input-item-cd" 
                oninput="handleCodeInput(this)"
                onblur="onHinbanBlur(this)">
          <select name="items[][color]"
              class="select-color"
              onchange="onColorChange(this)"
              disabled>
            <option value="">カラー</option>
          </select>
          <select name="items[][size]"
              class="select-size"
              onchange="onSizeChange(this)"
              disabled>
            <option value="">サイズ</option>
          </select>
        </div>
      </td>
      <td class="product-name-cell"><span class="product-name" style="color: #666;">-</span></td>
      <td class="product-price" data-price="0" style="text-align: right;">0</td>
      <td>
        <input type="number" 
                name="items[][quantity]" 
                value="1" 
                min="1" 
                class="item-quantity-input"
                oninput="calculateRowAndTotal()">
      </td>
      <td class="item-subtotal">0</td>
      <td>
        <button type="button" class="btn-remove" onclick="removeRow(this)">削除</button>
      </td>
    `;
    tbody.appendChild(newRow);
    renumberRows();
  }

  // 行削除
  function removeRow(button) {
    const tbody = document.getElementById('order-items-tbody');
    if (tbody.getElementsByClassName('item-row').length > 1) {
      button.closest('tr').remove();
      renumberRows();
      calculateRowAndTotal();
    } else {
      alert('明細は1行以上必要です。');
    }
  }

  // 行番号再振り直し
  function renumberRows() {
    const rows = document.querySelectorAll('#order-items-tbody .item-row');
    rows.forEach((row, index) => {
      row.querySelector('.row-number').textContent = index + 1;
    });
  }

document.getElementById('order-form').addEventListener('submit', function(e) {
  const codeInputs = document.querySelectorAll('.input-item-cd');
  let hasValidInput = false;

  ebugger;
  alert("明細入力チェックを通過しました！");

  codeInputs.forEach(input => {
    if (input.value.trim() !== '') {
      hasValidInput = true;
    }
  });

  // 1件も商品コードが入力されていない場合は送信をストップ
  if (!hasValidInput) {
    e.preventDefault();
    alert('明細を1件以上入力してください。');
  }
});

// 明細金額および合計金額を計算する関数
function calculateRowAndTotal() {
  let totalSum = 0;
  const rows = document.querySelectorAll('#order-table tbody tr');
    // console.log({ code });
  //  console.log("calculateRowAndTotal Begin");
    let idx = 0;
  rows.forEach(row => {
    const price = parseFloat(row.querySelector('.product-price').dataset.price) || 0;
    const quantityInput = row.querySelector('.item-quantity-input');
    const quantity = parseInt(quantityInput ? quantityInput.value : 0, 10) || 0;

    idx++;
    // alert("calculateRowAndTotal idx= " + idx);
    // if (idx = 2) {
    //   debugger;
    // }
    // 明細金額の計算
    const subtotal = price * quantity;
    const subtotalElement = row.querySelector('.item-subtotal');
    if (subtotalElement) {
      subtotalElement.textContent = subtotal.toLocaleString();
    }

    // 総合計の加算
    totalSum += subtotal;
  });

  // 総合計金額の表示更新
  const totalAmountElement = document.getElementById('total-amount');
  if (totalAmountElement) {
    totalAmountElement.textContent = totalSum.toLocaleString();
  }
}

// 数量入力時に計算を実行
document.addEventListener('input', function(e) {
  if (e.target.classList.contains('item-quantity-input')) {
    calculateRowAndTotal();
  }
});
</script>
