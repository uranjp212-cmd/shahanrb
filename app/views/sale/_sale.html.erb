          <select name="items[][color]"
                class="select-color"
                onchange="onColorChange(this)"
                readonly = true>
                <option value="">-</option>
          </select>
          <select name="items[][size]"
                class="select-size"
                onchange="onSizeChange(this)"
                readonly = true>
                <option value="">-</option>
          </select>
        </div>
        <%# 隠し項目群（税抜き単価・税率区分・税額などをサーバー送信用に保持） %>
        <input type="hidden" name="items[][baika]" class="item-baika-hidden" value="0">
        <input type="hidden" name="items[][zeirtkbn]" class="item-zeirtkbn-hidden" value="0">
        <input type="hidden" name="items[][juchutax]" class="item-juchutax-hidden" value="0">
        <input type="hidden" name="items[][hinmeir]" class="item-hinmeir-hidden" value="">
      </td>
      <td class="product-name-cell"><span class="product-name" style="color: #666;">-</span></td>
      <td class="product-price">
        <input type="number" 
                name="items[][juchukomigak]" 
                value="0" 
                class="item-price-input"
                style="text-align: right; width: 70px;"
                readonly=true>
      </td>
      <td>
        <input type="number" 
                name="items[][quantity]" 
                value="1" 
                min="1" 
                class="item-quantity-input"
                oninput="calculateRowAndTotal()">
      </td>
      <td class="item-subtotal">0</td>
      <td>
        <button type="button" class="btn-remove" onclick="removeRow(this)">削除</button>
      </td>
    `;
    tbody.appendChild(newRow);
    renumberRows();
  }

  // 行削除
  function removeRow(button) {
    const tbody = document.getElementById('order-items-tbody');
    if (tbody.getElementsByClassName('item-row').length > 1) {
      button.closest('tr').remove();
      renumberRows();
      calculateRowAndTotal();
    } else {
      alert('明細は1行以上必要です。');
