  // ① 品番入力時（フォーカスが外れた時）
  async function onHinbanBlur(inputEl) {
    const row = inputEl.closest('tr');
    const hinban = inputEl.value.trim();

    const colorSelect = row.querySelector('.select-color');
    const sizeSelect = row.querySelector('.select-size');
    const nameEl = row.querySelector('.product-name');
    const priceEl = row.querySelector('.product-price');
    const baikaEl = row.querySelector('.item-baika-hidden');
    const zeirtkbnEl = row.querySelector('.item-zeirtkbn-hidden');
    const hinmeirEl = row.querySelector('.item-hinmeir-hidden');

    // debugger;
    // ★ 品番が readonly の場合は処理を実行せずに終了
    if (inputEl.readOnly) {
      codereadonly = true;
      return;
      }
    // 初期化ヘルパー
    resetRow(row);

    // console.log({ hinban });
    if (!hinban) return;
    nameEl.textContent = '検索中...';

    try {
      const response = await fetch(`/products/search_by_hinban?hinban=${encodeURIComponent(hinban)}`);
      const data = await response.json();

      // alert("onHinban STEP01 " + hinban)
      if (data.found) {
        nameEl.textContent = data.name;
        hinmeirEl.value = data.name;
        nameEl.style.color = '#333';
        zeirtkbnEl.value = data.zeirtkbn;
        // 検索後は品番修正不可
        inputEl.readOnly = true;
        const colors = data.colors; // 例: ["RED", "BLUE"] または [" "]
        const sizes = data.sizes;   // 例: ["S", "M"] または [" "]
        const isSingleColor = colors.length === 1;
        const isSingleSize = sizes.length === 1;
        // alert("onHinban STEP02 " + data.is_single)
        if (isSingleColor) {
          // カラー欄は固定
          const value = colors[0]
          colorSelect.innerHTML = `<option value="${value}" selected>${value}</option>`;
          // colorSelect.innerHTML = '<option value=" "> </option>';
          colorSelect.readOnly = true;
        // ★ パターン②：カラーの選択が必要な場合
        } else {
          rowProductDataMap.set(row, data.color_size_map);
          colorSelect.innerHTML = '<option value="-">-</option>';
          data.colors.forEach(color => {
            const opt = document.createElement('option');
            opt.value = color;
            opt.textContent = color;
            colorSelect.appendChild(opt);
          });
          colorSelect.readOnly = false;
        }
        if (isSingleSize) {
          // サイズ欄は固定
          const value = sizes[0]
          sizeSelect.innerHTML = `<option value="${value}" selected>${value}</option>`;
          // sizeSelect.innerHTML = '<option value=" "> </option>';
          sizeSelect.readOnly = true;
        }
    // debugger;
        if (isSingleColor && !isSingleSize) {
          // カラー欄が固定であればサイズ欄のリストを設定
          const sizeList = data.color_size_map[colors[0]];
          rowProductDataMap.set(row, data.color_size_map);
          sizeSelect.innerHTML = '<option value="-">-</option>';
          sizeList.forEach(item => {
              const opt = document.createElement('option');
              opt.value = item.size;
              opt.textContent = item.size;
              opt.dataset.price = item.price; // 選択時に単価が取れるようデータ属性に忍ばせる
              sizeSelect.appendChild(opt);
            });
          sizeSelect.disabled = false;
        }
        // ----------------------------------------------------
        // パターンA: カラーもサイズも単一（完全単一）
        // ----------------------------------------------------
        if (isSingleColor && isSingleSize) {
          // 単価・金額を即座にセット
          baikaEl.value = data.price;
          // priceEl.textContent = Number(data.price).toLocaleString();
          // priceEl.dataset.price = data.price;
          calculateRowAndTotal();
        }

      } else {
        nameEl.textContent = data.message;
        nameEl.style.color = '#d9534f';
      }
    } catch (error) {
      console.error('品番検索エラー:', error);
      nameEl.textContent = '通信エラー';
    }
  }

  // ② カラー選択時
  function onColorChange(colorSelect) {
    const row = colorSelect.closest('tr');
    const selectedColor = colorSelect.value;
    const sizeSelect = row.querySelector('.select-size');
    // const priceEl = row.querySelector('.product-price');
    const priceEl = row.querySelector('.item-price-input');
    const baikaEl = row.querySelector('.item-baika-hidden');

    // if (codereadonly) return;
    
    // debugger;
    if (!selectedColor) return;

    const colorSizeMap = rowProductDataMap.get(row);
    if (!colorSizeMap || !colorSizeMap[selectedColor]) return;

    // 選択されたカラーに対応するサイズ候補を設定
    const sizeList = colorSizeMap[selectedColor];
    if (sizeList.length === 1) {
      // 選択されたサイズの単価を取得
      const price = parseInt(sizeList[0].price, 10) || 0;
      baikaEl.value = price;
      // priceEl.textContent = price.toLocaleString();
      // // priceEl.dataset.price = price; // ★計算用に data-price を更新！
      // priceEl.value = price;
      calculateRowAndTotal();
      return;
    }
    // サイズ・単価を一旦リセット
    sizeSelect.innerHTML = '<option value="">-</option>';
    sizeSelect.readOnly = true;
    baikaEl.value = '0';
    // priceEl.textContent = '0';
    // priceEl.dataset.price = '0';
    calculateRowAndTotal();
    sizeList.forEach(item => {
      const opt = document.createElement('option');
      opt.value = item.size;
      opt.textContent = item.size;
      opt.dataset.price = item.price; // 選択時に単価が取れるようデータ属性に忍ばせる
      sizeSelect.appendChild(opt);
    });

    sizeSelect.disabled = false;
  }

  // ③ サイズ決定時（ここで単価・金額確定）
  function onSizeChange(sizeSelect) {
    const row = sizeSelect.closest('tr');
    const selectedOption = sizeSelect.options[sizeSelect.selectedIndex];
    // const priceEl = row.querySelector('.product-price');
    const priceEl = row.querySelector('.item-price-input');
    const baikaEl = row.querySelector('.item-baika-hidden');

    // debugger;
    // if (codereadonly) return;
    if (selectedOption && selectedOption.value !== "") {
      // 選択されたサイズの単価を取得
      const price = parseInt(selectedOption.dataset.price, 10) || 0;
      baikaEl.value = price;
      // priceEl.textContent = price.toLocaleString();
      // // priceEl.dataset.price = price; // ★計算用に data-price を更新！
      // priceEl.value = price;
       calculateRowAndTotal();
    } else {
      priceEl.textContent = '0';
      priceEl.dataset.price = '0';
    }

    // 行小計および総合計の自動再計算
    calculateRowAndTotal();
  }

    // 表示リセット用の関数
  function resetRow(row) {
