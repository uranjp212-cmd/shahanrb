<div class="order-container">
  <h2>社販受注 <%= @is_edit ? "修正画面" : "登録画面" %></h2>
<!-- これはHTMLコメントです。二重化すると両方コメントとなる
<%# これはERBコメントです。ブラウザのHTMLソースには表示されません
  <p> val_readonly=<%= @val_readonly %></p>
%>
-->
  <!-- ★ 更新・登録成功メッセージ表示エリア -->
  <% if flash[:order_success] %>
    <div class="alert alert-success" style="background-color: #d4edda; color: #155724; padding: 12px 16px; margin-bottom: 20px; border: 1px solid #c3e6cb; border-radius: 4px; font-weight: bold;">
      <%= flash[:order_success] %>
    </div>
  <% elsif flash[:alert] %>
    <div class="alert alert-danger" style="background-color: #f8d7da; color: #721c24; padding: 12px 16px; margin-bottom: 20px; border: 1px solid #f5c6cb; border-radius: 4px; font-weight: bold;">
      <%= flash[:alert] %>
    </div>
  <% end %>
  <p class="user-info">ログイン社員: <%= current_shain.shaincd %> <%= current_shain.try(:shainmei) %></p>

  <% if @is_edit and !@is_completed %>
    <div class="alert alert-info" style="background-color: #e8f4f8; color: #1d6f8a; border-color: #bce8f1; padding: 10px; margin-bottom: 15px;">
      ※ 内容を変更して「更新する」を押すと上書き保存されます。
    </div>
  <% end %>
  <p ></p>
  <%= form_with(url: sale_path, local: true, data: { turbo: false },
        html: { onsubmit: "return validateSaleItems(event);" },
        id: "order-form") do |f| %>
    <input type="hidden" name="juchuno" value="<%= @juchuno %>">
    <input type="hidden" name="is_edit" value="<%= @is_edit %>">
    <%# 受取区分選択 %>
    <div class="form-group">
      <%= f.label :receipt_type, "受取区分", class: "fw-bold" %>
      <%= f.radio_button :receipt_type, "takeout",
            checked: (@receipt_type != 'delivery'), 
            onchange: "toggleDeliveryButton()" %> 持ち帰り
      <%= f.radio_button :receipt_type, "delivery",
            checked: (@receipt_type == 'delivery'), 
            onchange: "toggleDeliveryButton()" %> 配送
    </div>
    <div id="delivery-display-area" class="alert alert-secondary mt-2 mb-3" style="<%= @selected_delivery.present? ? '' : 'display: none;' %>">
    <%# 選択された配送先の表示エリア %>
      <%# ★ 配送先入力画面への遷移ボタン (formaction で送信先を変更) %>
      <div class="mb-3">
        <button type="button" 
                id="delivery-btn" 
                onclick="saveDraftAndRedirect()" 
                class="btn btn-outline-primary btn-sm"
                <%= @receipt_type == "delivery" ? "" : "disabled" %>>
          配送先を選択・変更する
        </button>
        <label id="dlv1" style="margin-left: 40px;">お届け日&nbsp;
          <input type="date" id="dlv2" name="dlvappbi" value="<%= @selected_delivery[:dlvappbi].presence || session[:sale_draft]&.dig(:dlvappbi) %>">
        </label>
        <label id="dlv3">&nbsp;&nbsp;&nbsp;時間帯指定&nbsp;
          <%= f.select :dlvkbn, 
                      options_for_select(@dlvkbn_options, @selected_delivery[:dlvkbn].presence || session[:sale_draft]&.dig(:dlvkbn)), 
                      { include_blank: "指定なし" }, 
                      { class: "form-select form-select-sm", id: "select-dlvkbn" } %>
        </label>
      </div>
<!-- これはHTMLコメント
      <select class="form-select form-select-sm" id="select-dlvkbn" name="dlvkbn">
        <option value="">指定なし</option>
<option value="01">午前中配達</option>
<option value="02">12時-14時</option>
<option value="03">14時-16時</option></select>
上記、フォームヘルパーでHTML展開したらこうなった↑↑↑↑↑
      <select name="select-dlvkbn" 
        class="select-dlvkbn" 
        value="<%# @dlvkbn %>">
        <option value="">-</option>
      </select>
-->
      <%# if @receipt_type == "delivery" %>
        <% if @selected_delivery.present? %>
          <% if @selected_delivery[:selection_type] == 'existing' %>
            <%# 一覧からの選択時：配送先番号を中心に表示 %>
            <div class="fw-bold text-primary">
              <i class="bi bi-check-circle-fill me-1"></i> お届先：<%= @selected_delivery[:delivmei] %> 　様を選択しました
            </div>
            <!-- これはHTMLコメントです。
            <div><strong>配送先番号:</strong> <%= @selected_delivery[:delivno] %></div>
            <div><strong>宛名:</strong> <%= @selected_delivery[:delivmei] %> 様</div>
            <div><strong>住所:</strong> 〒<%= @selected_delivery[:address_cd] %> <%= @selected_delivery[:address_after] %></div>
            -->
          <% elsif @selected_delivery[:selection_type] == 'new' %>
            <%# 新規入力の適用時：新規配送先として情報を表示 %>
            <div class="fw-bold text-primary">
              <i class="bi bi-check-circle-fill me-1"></i> お届先：<%= @selected_delivery[:delivmei] %> 　様を入力しました
            </div>
            <!-- これはHTMLコメントです。
            <div class="fw-bold text-success">
              <i class="bi bi-plus-circle-fill me-1"></i> 新規配送先を適用しました
            </div>
            <div><strong>宛名:</strong> <%= @selected_delivery[:delivmei] %> 様</div>
            <div><strong>電話番号:</strong> <%= @selected_delivery[:delivery_tel] %></div>
            <div><strong>住所:</strong> 〒<%= @selected_delivery[:address_cd] %> <%= @selected_delivery[:address_after] %></div>
            -->
          <% else %>
            <p class="text-muted">配送先が選択されていません。</p>
          <% end %>
        <% else %>
          <p class="text-muted">配送先が選択されていません。</p>
        <% end %>
      <%# end %>
      <%# サーバー送信用の隠しフィールド %>
      <input type="hidden" name="selection_type" value="<%= @selected_delivery[:selection_type] if @selected_delivery.present? %>">
      <input type="hidden" name="delivno" value="<%= @selected_delivery[:delivno] if @selected_delivery.present? %>">
      <input type="hidden" name="delivmei" value="<%= @selected_delivery[:delivmei] if @selected_delivery.present? %>">
      <input type="hidden" name="delivery_tel" value="<%= @selected_delivery[:delivery_tel] if @selected_delivery.present? %>">
      <input type="hidden" name="address_cd" value="<%= @selected_delivery[:address_cd] if @selected_delivery.present? %>">
      <input type="hidden" name="address_after" value="<%= @selected_delivery[:address_after] if @selected_delivery.present? %>">
      <input type="hidden" name="zipno" value="<%= @selected_delivery[:zipno] if @selected_delivery.present? %>">
    </div>
    <p ></p>
    <table class="order-table" id="order-table">
      <thead>
        <tr>
          <th style="width: 50px;">行</th>
          <th style="width: 200px;">商品コード</th>
          <th style="width: 300px;">商品名</th>
          <th style="width: 100px;">単価</th>
          <th>数量</th>
          <th>金額</th>
          <th style="width: 70px;">操作</th>
        </tr>
      </thead>
      <tbody id="order-items-tbody">
        <% @inputdtls.each_with_index do |item, index| %>
          <tr class="item-row">
            <td class="row-number"><%= index + 1 %></td>
            <td>
              <div style="display: flex; gap: 4px; align-items: center;">
              <!-- 1. 品番・カラー・サイズエリア -->
                <% if @is_completed || @is_edit %>
                  <input type="text" 
                        name="items[][item_cd]" 
                        value="<%= item[:item_cd] %>"
                        class="input-item_cd" 
                        style="width: 50px;"
                        readonly=true
                        >
                  <input type="text" 
                        name="items[][color]" 
                        class="select-color" 
                        value="<%= item[:color] %>"
                        style="width: 20px;"
                        readonly=true
                        >
                  <input type="text" 
                        name="items[][size]" 
                        class="select-size" 
                        value="<%= item[:size] %>"
                        style="width: 30px;"
                        readonly=true
                        >
                <% else %>
                  <!-- 品番（半角数字・英数等） -->
                  <input type="text" 
                        name="items[][item_cd]" 
                        value="<%= item[:item_cd] %>" 
                        placeholder="品番" 
                        class="input-item_cd" 
                        style="width: 50px;"
                        oninput="handleCodeInput(this)"
                        onblur="onHinbanBlur(this)">
                  <!-- カラー（初期は非活性、品番入力後に設定） -->
                  <select name="items[][color]" 
                          class="select-color" 
                          value="<%= item[:color] %>" 
                          onchange="onColorChange(this)" 
                          readonly = true>
                    <%# <option value="">カラー</option> %>
                  </select>
                  <!-- サイズ（初期は非活性、カラー選択後に設定） -->
                  <select name="items[][size]" 
                          class="select-size" 
                          value="<%= item[:size] %>" 
                          onchange="onSizeChange(this)" 
                          readonly = true>
                    <%# <option value="">サイズ</option> %>
                  </select>
                <% end %>
              </div>
              <%# 隠し項目群（税抜き単価・税率区分・税額などをサーバー送信用に保持） %>
              <input type="hidden" name="items[][baika]" class="item-baika-hidden" value="<%= item[:baika] || 0 %>">
              <input type="hidden" name="items[][zeirtkbn]" class="item-zeirtkbn-hidden" value="<%= item[:zeirtkbn] || '0' %>">
              <input type="hidden" name="items[][juchutax]" class="item-juchutax-hidden" value="<%= item[:juchutax] || 0 %>">
              <input type="hidden" name="items[][hinmeir]" class="item-hinmeir-hidden" value="<%= item[:hinmeir] || '' %>">
            </td>
            <!-- 商品名・税込み受注額の表示セル -->
            <td class="product-name"><%= item[:hinmeir] %></td>
            <td class="product-price">
              <input type="number" 
                      name="items[][juchukomigak]" 
                      value="<%= item[:juchukomigak] || 0 %>" 
                      class="item-price-input"
                      style="text-align: right; width: 70px;"
                      readonly=true>
            </td>
            <td>
              <input type="number" 
                      name="items[][quantity]" 
                      value="<%= item[:quantity] || 1 %>" 
                      min="1" 
                      class="item-quantity-input"
                      <%= "readonly=true" if @is_completed %> 
                      oninput="calculateRowAndTotal()">
            </td>
            <td class="item-subtotal">
              <%= (item[:subtotal] || 0) %>
            </td>
            <td>
              <button type="button"
                      class="btn-remove"
                      <%= "disabled" if @is_completed %> 
                      onclick="removeRow(this)">削除</button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="total-container" style="text-align: right; margin: 15px 0; font-size: 1.2em; font-weight: bold;">
      合計金額: <span id="total-amount">0</span> 円
    </div>

    <% if !@is_completed %>
      <div class="table-actions">
        <button type="button" id="btn-add-row" class="btn-secondary" onclick="addRow()">+ 行を追加する</button>
      </div>
      <div class="form-actions">
        <%= f.submit (@is_edit ? "受注内容を更新する" : "受注を確定する"), class: "btn-primary" %>
      </div>
    <% end %>
  <% end %>
<!-- これはHTMLコメントです。二重化すると両方コメントとなる
<%# これはERBコメントです。ブラウザのHTMLソースには表示されません
  <p style="color: red; font-weight: bold;">
    デバッグ表示: <%= @is_completed.inspect %>
  </p>
  <p >session[:back_to_index]=<%= session[:back_to_index].to_s %></p>
%>
-->
  <br>
  <!-- ★ 登録完了時に表示されるログアウトボタン -->
  <% if session[:back_to_index] %>
    <%= link_to "一覧に戻る", index_sale_path, class: "btn-logout", style: "background-color: #dc3545; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px;" %>
  <% else %>
    <%= link_to (@is_completed ? "ログアウトする" : "戻る"), logout_path, data: { turbo_method: :delete }, class: "btn-logout", style: "background-color: #dc3545; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px;" %>
  <% end %>
</div>

