// 明細金額および合計金額を計算する関数
function calculateRowAndTotal() {
  let grandTotalProductPrice = 0;
  document.querySelectorAll('.item-row').forEach(row => {
    // 要素の取得
    const baikaHidden        = row.querySelector('.item-baika-hidden');
    const zeirtkbnHidden      = row.querySelector('.item-zeirtkbn-hidden');
    const quantityInput      = row.querySelector('.item-quantity-input');

    const taxAmountHidden    = row.querySelector('.item-juchutax-hidden');
    const productPriceText   = row.querySelector('.item-price-input');
    const subtotalText       = row.querySelector('.item-subtotal');

    const priceEl = row.querySelector('.product-price');

    // １．単価 baika と 税率区分 zertkbn の取得
    const baika    = parseFloat(baikaHidden?.value) || 0;
    const zertkbn  = zeirtkbnHidden?.value || '0';
    const quantity = parseFloat(quantityInput?.value) || 0;

    // ２．コード名称マスタから税率 zeirt を取得
    const zeirt = TAX_RATE_MAP[zertkbn] ?? 0.10;

    // 2.5．税込単価 = baika * zeirt（端数切り捨て）
    const taxBaika = Math.floor(baika * zeirt);
    const price = baika + taxBaika;
    if (productPriceText)   productPriceText.textContent = price.toLocaleString();
    priceEl.textContent = price.toLocaleString();
    priceEl.dataset.price = price;

    // ３．税額 = baika * zeirt * 数量（端数切り捨て）
    const taxAmount = Math.floor(baika * zeirt) * quantity;

    // ４．税込み額 product-price = baika * 数量 + 税額
    const productPrice = (baika * quantity) + taxAmount;

    // 算出結果を隠しフィールドと画面表示に反映
    if (taxAmountHidden)    taxAmountHidden.value = taxAmount;
    if (subtotalText)   subtotalText.textContent = productPrice.toLocaleString();

    grandTotalProductPrice += productPrice;
  });

  // 画面下部の総合計表示を更新
  const totalAmountEl = document.getElementById('total-amount');
  if (totalAmountEl) {
    totalAmountEl.textContent = grandTotalProductPrice.toLocaleString();
  }
}

