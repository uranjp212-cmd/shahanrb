// Rails の @tax_rate_table を JSON 化して JS に渡す
var TAX_RATE_TABLE = <%= raw @tax_rate_table.to_json %>;

// 税率区分コードから計算用小数（0.10 など）を取得する関数
function getTaxRateByKbn(taxKbn) {
  const target = TAX_RATE_TABLE.find(item => item.tax_kbn === taxKbn);
  return target ? target.tax_rate : 0.10; // 該当なしはデフォルト 10%
}

// 計算例：単価 × 数量 × (1 + 税率)
function calculateTaxIncluded(price, qty, taxKbn) {
  const rate = getTaxRateByKbn(taxKbn);
  const subtotalNoTax = price * qty;
  const taxAmount = Math.floor(subtotalNoTax * rate); // 端数切り捨ての場合
  return subtotalNoTax + taxAmount;
}

// 受取区分の変更時に配送先ボタンの有効/無効、および表示エリアを切り替える
function toggleDeliveryButton() {
  const deliveryRadio = document.querySelector('input[name="receipt_type"][value="delivery"]');
  const deliveryBtn = document.getElementById('delivery-btn');
  const deliveryDisplayArea = document.getElementById('delivery-display-area');

  if (deliveryRadio.checked) {
    deliveryBtn.removeAttribute('disabled'); // 有効化
    if (deliveryDisplayArea.innerHTML.trim() !== "") {
      deliveryDisplayArea.style.display = 'block';
    }
  } else {
    deliveryBtn.setAttribute('disabled', 'true'); // 無効化
    deliveryDisplayArea.style.display = 'none';   // 非表示
  }
}

function saveDraftAndRedirect() {
  // フォーム全体の要素を取得
  const form = document.getElementById('order-form');
  const formData = new FormData(form);

  // Railsのメタタグから CSRF トークンを確実に取得
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

  // fetchでバックグラウンド送信（セッションに一時保存）
  fetch('<%= save_draft_and_redirect_sale_index_path %>', {
    method: 'POST',
    headers: {
      'X-CSRF-Token': csrfToken,
      'Accept': 'application/json'
    },
    body: formData
  })
  .then(response => {
    if (response.ok) {
      // 保存に成功したら配送先選択画面へ遷移
      // window.location.href = '<%= delivery_input_sale_index_path %>';
      // window.saleMode に応じて遷移先のURLを動的に組み立てる
      let deliveryUrl = '<%= delivery_input_sale_index_path %>';
      if (window.saleMode === 'edit' && window.targetJuchuno) {
        // 修正モードの場合：mode=edit と juchuno を付与
        deliveryUrl += `?mode=edit&juchuno=${window.targetJuchuno}`;
      } else {
        // 新規モードの場合：mode=new を付与
        deliveryUrl += '?mode=new';
      }
      // 配送先画面へ遷移
      window.location.href = deliveryUrl;
    } else {
      alert('一時保存に失敗しました。');
    }
  })
  .catch(error => {
    console.error('Error:', error);
    alert('通信エラーが発生しました。');
  });
}

// 商品名を取得する関数
async function getHinmei() {
  const rows = document.querySelectorAll('.item-row');
  
  // for...of ループを使うことで、ループ内で安全に await が使えるようになります
  for (const row of rows) {
    // 要素の取得
    const hinbanInput = row.querySelector('.input-item_cd');
    const nameSpan    = row.querySelector('.product-name'); // 商品名を表示する要素
    const hinmeirSpan = row.querySelector('.item-hinmeir-hidden');
    
    const hinban = hinbanInput ? hinbanInput.value.trim() : '';

    // 品番等がある場合、サーバーから商品名を取得して表示を更新する
    if (hinban.length > 0) {
      try {
        const response = await fetch(`/products/search_by_hinban?hinban=${encodeURIComponent(hinban)}`);
        const data = await response.json();

        if (data.found && nameSpan) {
          nameSpan.textContent = data.name; // 取得した商品名をセット
          hinmeirSpan.value = data.name;
        } else if (nameSpan) {
          nameSpan.textContent = '（商品が見つかりません）';
        }
      } catch (error) {
        console.error('商品名取得エラー:', error);
      }
    }
  }
}

