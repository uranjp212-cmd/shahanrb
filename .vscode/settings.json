{
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/node_modules/*/**": true,
      "**/log/**": true,
      "**/tmp/**": true,
      "**/vendor/bundle/**": true,
      "**/public/assets/**": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/bower_components": true,
      "**/*.code-search": true,
      "**/log": true,
      "**/tmp": true,
      "**/vendor/bundle": true
    }
  }